.program ads8861_capture
.side_set 1

; One GP4 TX falling edge starts an entire 8-window decay sweep.
; GP8=CONVST, GP9=SCLK, GP10=DOUT. ADS8861 DIN is tied HIGH (3-wire CS).
; clk_sys/PIO clock must be 125 MHz.
; CONVST high = six 16-cycle instructions = 96 cycles = 768 ns (> 710 ns tconv-max).
; SCLK = 7 cycles high + 7 cycles low = 8.929 MHz (50% duty).
; DOUT MSB is sampled 120 ns after CONVST falls (t_d-CNV-DO max 12.3 ns).
; ADS8861 updates DOUT after each SCLK falling edge (t_d-CK-DO max 13.4 ns),
; so IN samples on the following rising edge (side-set HIGH), not on falling.
;
; One 32-bit word is explicitly pulled into OSR; the remaining three words are preloaded in TX FIFO. Each word carries two
; 12-bit delay-loop counts. OUT shift-right/autopull threshold is 24 bits.
; The eight trigger delays from TX falling are nominally:
; 8, 12, 16, 24, 36, 52, 72, 100 us.
; Loop counts include the known PIO instruction budget and an assumed
; 2-cycle GPIO input synchronizer. Verify/trim the first offset on hardware.

.wrap_target
    wait 1 gpio 4 side 0
    wait 0 gpio 4 side 0
    set y, 7 side 0

sample_loop:
    out x, 12 side 0

delay_loop:
    jmp x-- delay_loop side 0

    set pins, 1 side 0 [15]
    nop side 0 [15]
    nop side 0 [15]
    nop side 0 [15]
    nop side 0 [15]
    nop side 0 [15]
    set pins, 0 side 0 [11]
    set x, 15 side 0
    nop side 0 [1]

bitloop:
    in pins, 1 side 1 [6]
    jmp x-- bitloop side 0 [6]

    jmp y-- sample_loop side 0
.wrap
